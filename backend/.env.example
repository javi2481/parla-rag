# LlamaCloud (LlamaParse): Parse, Split, Classify, Schema y Extract. Región EU: https://api.cloud.eu.llamaindex.ai
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai
# Parse: tier (fast · cost_effective · agentic · agentic_plus) y versión fija
PARSE_TIER=agentic
PARSE_VERSION=2026-10-16
MAX_UPLOAD_MB=50

# Bibliotecas: "local" (LlamaIndex + Voyage AI + OpenAI, en este servidor) o "llamacloud" (necesita un plan pago)
LIBRARY_ENGINE=local
# Voyage AI: embeddings y reranker de las bibliotecas locales. https://dash.voyageai.com
VOYAGE_API_KEY=
LIBRARY_EMBED_MODEL=voyage-4
LIBRARY_RERANK_MODEL=rerank-2.5
# Cómo se cortan las páginas: "pagina" (no corta: cada página es un chunk), "oraciones" (SentenceSplitter)
# o "markdown" (MarkdownNodeParser, corta por títulos)
LIBRARY_SPLITTER=pagina
# OpenAI: el modelo de lenguaje del chat de las bibliotecas locales. https://platform.openai.com
OPENAI_API_KEY=
LIBRARY_CHAT_MODEL=gpt-5-nano
# Cuánto razona gpt-5-nano antes de responder: minimal, low, medium o high (más razonamiento = más tokens pagos)
LIBRARY_REASONING_EFFORT=minimal
# El razonamiento del juez de los evals, aparte del chat (así se compara con el mismo juez)
LIBRARY_JUDGE_REASONING_EFFORT=low
# Cuántas páginas (las mejores según el reranker) se le pasan al modelo en cada pregunta
LIBRARY_CHAT_TOP_K=6

# Límite simple en memoria, por IP (0 = sin límite)
DOCUMENTS_DAILY_LIMIT=0

# Orígenes permitidos para CORS (solo hace falta si el frontend no usa el proxy de Vite)
CORS_ORIGINS=http://localhost:5173