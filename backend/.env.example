# LlamaCloud (LlamaExtract). Región EU: https://api.cloud.eu.llamaindex.ai
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai
# Tier de LlamaExtract (créditos por página): cost_effective 8 · agentic 25 · agentic_plus 60 · turbo 35
EXTRACT_TIER=agentic
# "latest" o una versión fija (ej. 2.5) para resultados reproducibles
EXTRACT_VERSION=latest

# ElevenLabs (TTS con voz clonada + Scribe STT)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ZjGTaa77PsTCKjCfcbjG
# eleven_flash_v2_5 = mitad de créditos por carácter. eleven_v4 / eleven_multilingual_v2 = máxima calidad (x2)
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# Límites simples en memoria, por IP (0 = sin límite)
INVOICE_DAILY_LIMIT=50
AUDIO_LIMIT_PER_10_MIN=30
TTS_MAX_CHARS=2500

# Caché en disco de audios generados: el mismo texto nunca se paga dos veces
TTS_CACHE_DIR=.cache/tts
TTS_CACHE_MAX_MB=200

# Orígenes permitidos para CORS (solo hace falta si el frontend no usa el proxy de Vite)
CORS_ORIGINS=http://localhost:5173
